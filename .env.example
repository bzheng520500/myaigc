DATABASE_URL=
AUTH_SECRET=
# SMTP 优先（163 示例：smtp.163.com / 465，SMTP_PASS 填授权码不是登录密码）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# 发件人必须与 SMTP_USER 一致（163 校验 MAIL FROM 与认证账号一致）
AUTH_EMAIL_FROM=
# 备用通道：SMTP_* 三项齐全时忽略
RESEND_API_KEY=
AUTH_DEV_MODE=
CRON_SECRET=
# 摘要邮件链接基地址（如 https://your-domain.com），生产必填
NEXT_PUBLIC_BASE_URL=
