{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-film-workshop",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // 非敏感的运行时变量（secrets 用 `wrangler secret put`，勿放这里）
  // NEXT_PUBLIC_BASE_URL：每日摘要邮件里链接的基地址（worker.ts / cron route 读取）
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://aigc.chatgpta.ccwu.cc"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-film-workshop",
      "database_id": "b0ae4fa6-7201-4c7b-bc23-fecbb93d6483",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "352a52a3132f424f8bc911bf44aa3234"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
